https://leetcode.com/problems/find-k-pairs-with-smallest-sums/description/

class Solution {
public:
    vector<vector<int>> kSmallestPairs(vector<int>& nums1, vector<int>& nums2,
                                       int k) {

        vector<vector<int>> ans;
        set<pair<int, int>> stt;

        priority_queue<pair<int, pair<int, int>>,
                       vector<pair<int, pair<int, int>>>,
                       greater<pair<int, pair<int, int>>>>
            pq;

        pq.push({nums1[0] + nums2[0], {0, 0}});
        stt.insert({0, 0});

        while (k > 0 && !pq.empty()) {
            int idx1 = pq.top().second.first;
            int idx2 = pq.top().second.second;
            pq.pop();

            ans.push_back({nums1[idx1], nums2[idx2]});
            k--;

            if (idx1 + 1 < nums1.size()) {
                if (stt.find({idx1 + 1, idx2}) == stt.end()) {
                    pq.push({nums1[idx1 + 1] + nums2[idx2], {idx1 + 1, idx2}});
                    stt.insert({idx1 + 1, idx2});
                }
            }

            if (idx2 + 1 < nums2.size()) {
                if (stt.find({idx1, idx2 + 1}) == stt.end()) {
                    pq.push({nums2[idx2 + 1] + nums1[idx1], {idx1, idx2 + 1}});
                    stt.insert({idx1, idx2 + 1});
                }
            }
        }

        return ans;
    }
};
