https://leetcode.com/problems/number-of-ways-to-assign-edge-weights-i/description/

class Solution {
public:
    const int mod = 1e9 + 7;
    long long dp[100001][2];
    long long f(int edges, int rem, int max_depth) {
        if (edges == max_depth) {
            return rem;
        }

        if (dp[edges][rem] != -1) {
            return dp[edges][rem];
        }

        long long ans = 0;

        // taking 1
        ans = (ans + f(edges + 1, (rem + 1) % 2, max_depth)) % mod;

        // taking 2
        ans = (ans + f(edges + 1, (rem + 2) % 2, max_depth)) % mod;

        return dp[edges][rem] = ans;
    }

    int assignEdgeWeights(vector<vector<int>>& edges) {

        int n = edges.size() + 1;

        vector<vector<int>> adj(n + 1);
        for (int i = 0; i < n - 1; i++) {
            adj[edges[i][0]].push_back(edges[i][1]);
            adj[edges[i][1]].push_back(edges[i][0]);
        }

        vector<int> dis(n + 1, -1);
        queue<int> q;
        q.push(1);
        dis[1] = 0;

        int maxi_depth = 0;

        while (!q.empty()) {
            int node = q.front();
            int dist = dis[node];
            q.pop();
            maxi_depth = max(maxi_depth, dist);

            for (auto it : adj[node]) {
                if (dis[it] == -1) {
                    dis[it] = dist + 1;
                    q.push(it);
                }
            }
        }

        memset(dp, -1, sizeof(dp));

        return (int)f(0, 0, maxi_depth);
    }
};

