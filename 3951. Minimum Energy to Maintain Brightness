https://leetcode.com/problems/minimum-energy-to-maintain-brightness/description/


class Solution {
public:
    long long minEnergy(int n, int brightness, vector<vector<int>>& intervals) {

        long long total_e = ceil((double)brightness / 3);
        sort(intervals.begin(), intervals.end());
        long long sum = 0;
        long long l = -1, r = -1;

        for (int i = 0; i < intervals.size(); i++) {
            if (intervals[i][0] > r) {
                l = intervals[i][0];
                r = intervals[i][1];
            } else {
                l = max(intervals[i][0] * 1LL, r + 1);
                if (intervals[i][1] <= r) {
                    continue;
                } else {
                    r = intervals[i][1];
                }
            }
            if (r - l >= 0) {
                sum += r - l + 1;
            }
        }
        return sum * total_e;
    }
};
