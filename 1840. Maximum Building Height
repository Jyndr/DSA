class Solution {
public:
    int maxBuilding(int n, vector<vector<int>>& r) {

        r.push_back({1, 0});
        sort(r.begin(), r.end());

        if (r[r.size() - 1][0] != n) {
            r.push_back({n, n - 1});
        }

        for (int i = 1; i < r.size(); i++) {
            r[i][1] = min(r[i][1], r[i][0] - r[i - 1][0] + r[i - 1][1]);
        }

        for (int i = r.size() - 2; i >= 0; i--) {
            r[i][1] = min(r[i][1], r[i + 1][1] + r[i + 1][0] - r[i][0]);
        }

        int ans = 0;

        for (int i = 0; i < r.size() - 1; i++) {
            int d = r[i + 1][0] - r[i][0];
            int h = max(r[i][1], r[i + 1][1]);
            int diff = d - abs(r[i][1] - r[i + 1][1]);

            ans = max(ans, h + diff / 2);
        }

        return ans;
    }
};
