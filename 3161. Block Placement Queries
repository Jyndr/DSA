class Solution {
public:
    vector<bool> getResults(vector<vector<int>>& queries) {

        
        int n = 50000;
        Tree segtree(n + 1);

        vector<bool> ans;

        set<int> stt;
        stt.insert(0);
        stt.insert(n); 

        segtree.update(0, n, 0, n, n);

        for (int i = 0; i < queries.size(); i++) {
            if (queries[i][0] == 2) {
                int x = queries[i][1];
                int sz = queries[i][2];

                // Step A: Get max fully enclosed gap from the segment tree
                int max_closed_gap = segtree.query(0, n, 0, 0, x);

                // Step B: Calculate the trailing gap up to 'x'
                auto it = stt.upper_bound(x); // First obstacle AFTER x
                it--; // Go back one to get the last obstacle <= x
                int last_obstacle = *it;
                int trailing_gap = x - last_obstacle;

                // Step C: The real max gap is the larger of the two
                int real_max_gap = max(max_closed_gap, trailing_gap);

                ans.push_back(real_max_gap >= sz);

            } else {
                int b = queries[i][1];

                auto lb = stt.lower_bound(b);
                // Because 0 and 50005 are in the set, these are 100% safe to
                // dereference. We no longer need the hardcoded '50000'
                // fallback!
                int curr = *lb;
                int prevv = *prev(lb);

                segtree.update(0, n, 0, curr, curr - b);
                segtree.update(0, n, 0, b, b - prevv);

                stt.insert(b);
            }
        }
        return ans;
    }
};
