class Tree {
public:
    vector<int> segtree;

    Tree(int n) { segtree.resize(4 * n); }

    int query(int left, int right, int node, int ql, int qr) {
        if (qr < left || ql > right) {
            return INT_MIN;
        } else if (right <= qr && left >= ql) {
            return segtree[node];
        }
        int mid = left + (right - left) / 2;

        int left_ans = query(left, mid, node * 2 + 1, ql, qr);
        int right_ans = query(mid + 1, right, node * 2 + 2, ql, qr);

        if (qr <= mid) {
            return left_ans;
        } else if (ql > mid) {
            return right_ans;
        } else {
            return max(left_ans, right_ans);
        }
    }

    void update(int left, int right, int node, int idx, int val) {
        if (left == right) {
            segtree[node] = val;
            return;
        }

        int mid = left + (right - left) / 2;
        if (idx <= mid)
            update(left, mid, node * 2 + 1, idx, val);
        else
            update(mid + 1, right, node * 2 + 2, idx, val);

        segtree[node] = max(segtree[node * 2 + 1], segtree[node * 2 + 2]);
    }
};

