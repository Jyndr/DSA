https://takeuforward.org/plus/dsa/problems/search-in-a-2d-matrix?subject=dsa&approach=optimal-approach

class Solution {
   public:
    bool searchMatrix(vector<vector<int>> &mat, int target) {
        int n = mat.size();
        int m = mat[0].size();
        int low = 0, high = n * m - 1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            int midi = mid / m;
            int midj = mid % m;

            if (mat[midi][midj] == target) {
                return true;
            } else if (mat[midi][midj] < target) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }
        return false;
    }
};

