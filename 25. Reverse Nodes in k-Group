https://leetcode.com/problems/reverse-nodes-in-k-group/description/


/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */

class Solution {
public:
    void reverse_list(ListNode* head, ListNode* end) {
        ListNode* prevv = nullptr;
        ListNode* curr = head;
        ListNode* nextt = nullptr;

        while (prevv != end) {
            nextt = curr->next;
            curr->next = prevv;
            prevv = curr;
            curr = nextt;
        }
    }

    ListNode* reverseKGroup(ListNode* head, int k) {
        ListNode* prevv = nullptr;
        ListNode* nextt = nullptr;
        ListNode* start = head;
        ListNode* end = head;

        while (true) {
            int times = k;
            end = start;
            while (times > 1 && end) {
                end = end->next;
                times--;
            }

            if (!end) {
                if (prevv)
                    prevv->next = start;
                break;
            }

            nextt = end->next;
            end->next = nullptr;

            reverse_list(start, end);

            if (start == head) {
                head = end;
            }

            if (prevv) {
                prevv->next = end;
            }

            start->next = nextt;
            prevv = start;
            start = nextt;
        }
        return head;
    }
};
